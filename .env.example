# Copy to .env.local. `npm run dev` works with this file empty: it uses an embedded
# database and generates the three secrets into .data. Production needs all of the first block.

APP_URL=http://127.0.0.1:3000
# Postgres (Neon from the Vercel Marketplace works). Leave empty in development for the embedded database.
DATABASE_URL=

# openssl rand -base64 48
BETTER_AUTH_SECRET=
# openssl rand -base64 32   (encrypts platform tokens at rest)
TOKEN_ENCRYPTION_KEY=
# openssl rand -hex 24      (bearer token for /api/cron/sync)
CRON_SECRET=

# Optional: social sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: email (verification and password reset). Without it, emails are logged and verification is skipped.
RESEND_API_KEY=
EMAIL_FROM="Tendril <hello@example.com>"

# Optional: billing with Polar (https://polar.sh). Create two monthly products and paste their ids.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
POLAR_PRODUCT_GROWER=
POLAR_PRODUCT_STUDIO=

# Bluesky works locally with no setup. In production: npx tsx scripts/generate-bluesky-key.ts
BLUESKY_PRIVATE_JWK=

# Optional: X API (OAuth 2.0 app). Room search needs the Basic tier or higher.
X_CLIENT_ID=
X_CLIENT_SECRET=

# Optional: Threads API (Meta app with the Threads use case)
THREADS_APP_ID=
THREADS_APP_SECRET=

# Optional: LinkedIn (Sign In with LinkedIn using OpenID Connect)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Shown on the privacy page and in emails
SUPPORT_EMAIL=support@example.com

# AI: the assistant and Autopilot. https://console.anthropic.com
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
